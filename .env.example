# Copy this file to .env and fill in real values for local development.
# Only EXPO_PUBLIC_* variables are inlined into the JS bundle - never put
# secrets (private API keys, service credentials) behind this prefix.
# Non-public secrets belong in EAS Secrets (`eas secret:create`) and are
# consumed only by your backend, never bundled into the app.

EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_ANALYTICS_PROVIDER=console
